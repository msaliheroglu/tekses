# deploy/.env — doldurup .env adıyla kaydedin (asla commit'lemeyin).

# VM'in genel IP'sine A kaydıyla işaret eden alan adı (ör. tekses.ornek.com).
# Ücretsiz seçenek: DuckDNS alt alan adı da çalışır.
TEKSES_DOMAIN=

# Postgres parolası (rastgele uzun bir değer üretin).
POSTGRES_PASSWORD=

# Gateway konsol uçlarının (kue/müdahale/runs) Bearer token'ı.
# İnternete açık kurulumda ZORUNLU tutulur; paneldeki "gateway yönetici
# token'ı" alanına da aynı değer girilir.
TEKSES_ADMIN_TOKEN=
