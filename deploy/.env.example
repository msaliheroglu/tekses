# deploy/.env — doldurup .env adıyla kaydedin (asla commit'lemeyin).

# VM'in genel IP'sine A kaydıyla işaret eden alan adı (ör. tekses.ornek.com).
# Ücretsiz seçenek: DuckDNS alt alan adı da çalışır.
TEKSES_DOMAIN=

# Postgres parolası (rastgele uzun bir değer üretin).
POSTGRES_PASSWORD=

# Gateway konsol uçlarının (kue/müdahale/runs) Bearer token'ı.
# İnternete açık kurulumda ZORUNLU tutulur. Panelde oturum açmak konsol için
# yeterlidir; bu token yalnız panel oturumu olmadan (otomasyon/acil durum)
# kullanılır.
TEKSES_ADMIN_TOKEN=

# Servisler arası iç uç sırrı (gateway → control-api /internal/runs):
# kue/müdahale izlerinin Postgres'e KALICI yazımını açar (openssl rand -hex 16).
# Boş bırakılabilir — o zaman izler yalnız gateway'in 50'lik halkasında yaşar.
TEKSES_INTERNAL_TOKEN=
