# Tek alan adı, yol bazlı dağıtım. TLS'i Caddy otomatik alır (Let's Encrypt).
#
# Telefonlar:   wss://ALAN/ws  +  https://ALAN (katılım: /join?code=…)
# Moderatör:    https://ALAN (panel)
# Uygulama içi adresler: Gateway = wss://ALAN/ws, Control = https://ALAN

{$TEKSES_DOMAIN} {
	encode gzip

	# Gateway: WebSocket, Faz 0 konsol API'si ve tarayıcı katılımcı sayfası
	handle /ws {
		reverse_proxy gateway:8080
	}
	handle /api/v0/* {
		reverse_proxy gateway:8080
	}
	handle /join {
		reverse_proxy gateway:8080
	}
	handle /healthz {
		reverse_proxy gateway:8080
	}

	# Control API: kontrol düzlemi, paket ve ses varlığı indirme
	handle /api/v1/* {
		reverse_proxy control-api:8090
	}
	handle /packages/* {
		reverse_proxy control-api:8090
	}
	handle /assets/* {
		reverse_proxy control-api:8090
	}

	# Panelin API çağrıları: /control ve /gw önekleri burada soyulur ve
	# doğrudan servislere gider. (Next.js rewrites yalnızca yerel geliştirme
	# içindir: hedef adresler derleme anında gömüldüğünden Docker imajında
	# localhost'a işaret eder — bu yüzden üretimde Caddy yönlendirir.)
	#
	# Servisler arası İÇ uçlar (/internal/*) internete kapatılır: önek
	# soyma olmasa yol zaten panele düşer ama /control/internal/… soymayla
	# control-api'ye VARIRDI. Uç ayrıca TEKSES_INTERNAL_TOKEN ister; bu
	# kural derinlemesine savunmadır.
	handle /control/internal/* {
		respond "" 404
	}
	handle /control/* {
		uri strip_prefix /control
		reverse_proxy control-api:8090
	}
	handle /gw/* {
		uri strip_prefix /gw
		reverse_proxy gateway:8080
	}

	# Geri kalan her şey moderatör paneli
	handle {
		reverse_proxy moderator:3000
	}
}
