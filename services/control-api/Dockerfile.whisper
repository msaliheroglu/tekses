# Söz çıkarma (whisper.cpp) DESTEKLİ control-api imajı — isteğe bağlı varyant.
#
# Kullanım (deploy/ dizininde):
#   docker compose -f docker-compose.yml -f docker-compose.whisper.yml up -d --build control-api
#
# Standart imajdan (Dockerfile) farkı: ffmpeg + jq + whisper-cli + çok dilli
# "small" model (~466 MB) içerir ve TEKSES_TRANSCRIBER hazır ayarlıdır. İmaj
# ~1 GB büyür; ilk derleme whisper.cpp'yi kaynaktan derlediği için VM'de
# 10-15 dk sürebilir (bir kez).
#
# Demucs (vokal ayrıştırma) bilinçli olarak YOK: torch tabanlı ve CPU'da tek
# şarkı bile dakikalarca sürüyor — ücretsiz ARM VM'de zaman aşımına sığmaz.
# Bu yüzden mikslenmiş şarkılarda taslak kalitesi düşüktür (Whisper vokali
# enstrümandan ayıramaz); kesin yol LRC içe aktarma. Tezahürat/anons gibi
# konuşma ağırlıklı seslerde iyi çalışır.

FROM golang:1.25-alpine AS gobuild
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY packages/ packages/
COPY services/control-api/ services/control-api/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/control-api ./services/control-api/cmd/control-api

FROM debian:bookworm-slim AS whisperbuild
RUN apt-get update && apt-get install -y --no-install-recommends \
        git build-essential cmake ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 https://github.com/ggml-org/whisper.cpp /w
RUN cmake -B /w/build /w -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
    && cmake --build /w/build -j --target whisper-cli
RUN curl -fL -o /w/ggml-small.bin \
    https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-small.bin

FROM debian:bookworm-slim
# libgomp1: whisper.cpp OpenMP ile derlenir; ffmpeg/jq betiğin bağımlılıkları.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg jq libgomp1 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -M tekses && mkdir -p /data/packages && chown tekses /data/packages
COPY --from=gobuild /out/control-api /usr/local/bin/control-api
COPY --from=whisperbuild /w/build/bin/whisper-cli /opt/whisper/whisper-cli
COPY --from=whisperbuild /w/ggml-small.bin /opt/whisper/ggml-small.bin
COPY --chmod=755 deploy/transcribe-whisper.sh /opt/tekses/transcribe-whisper.sh
USER tekses
ENV TEKSES_PACKAGES_DIR=/data/packages \
    TEKSES_TRANSCRIBER=/opt/tekses/transcribe-whisper.sh \
    WHISPER_BIN=/opt/whisper/whisper-cli \
    WHISPER_MODEL=/opt/whisper/ggml-small.bin
VOLUME /data/packages
EXPOSE 8090
ENTRYPOINT ["control-api"]
